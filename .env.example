# Copy this file to .env and fill in your values. Never share or commit .env.
TELEGRAM_BOT_TOKEN=paste-token-from-BotFather
# Your personal Telegram user ID: message the bot /start and it replies with it. Only this user can DM prompts.
TELEGRAM_OWNER_ID=
# Optional: your private capture channel (notes there are triaged first)
TELEGRAM_CHAT_ID=-100xxxxxxxxxx
GEMINI_API_KEY=paste-key-from-aistudio.google.com
GEMINI_MODEL=gemini-flash-latest
# Triage score 0-10; notes below this get rejected (you can still tap "Draft anyway")
MIN_SCORE=6
